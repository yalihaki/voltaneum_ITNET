[Unit]
Description=Voltaneum model monitoring
After=network-online.target voltaneum.service
Wants=network-online.target

[Service]
Type=simple
User=voltaneum
Group=voltaneum
WorkingDirectory=/opt/voltaneum
EnvironmentFile=/opt/voltaneum/.env
ExecStart=/opt/voltaneum/venv/bin/python /opt/voltaneum/run_model_monitor.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/voltaneum

[Install]
WantedBy=multi-user.target
