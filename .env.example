# =============================================================================
# Voltaneum / ITNET — fichier d'exemple de configuration.
# Copier en ".env" et renseigner les valeurs réelles. Ne JAMAIS committer le
# ".env" lui-même (voir .gitignore) — ce fichier ne contient aucune valeur
# secrète, uniquement des exemples/valeurs par défaut sûres.
# =============================================================================

# --- Identifiants passerelle (OBLIGATOIRE, aucune valeur par défaut) --------
VOLTANEUM_USER=
VOLTANEUM_PASSWORD=

# --- Réseau : automate / passerelle -----------------------------------------
GATEWAY_HOST=10.0.1.33
MANAGE_API_URL=http://10.0.1.33/ManageApi/Base.Auth.php
IOT_API_URL=http://10.0.1.33:8001/iot/query_all_points
WS_URL=ws://10.0.1.33:91
SENSOR_DRIVER_NODE=idospV1_1
# Flux muet au-delà de ce délai (s) : connexion rouverte (0 = désactivé)
WS_SILENCE_TIMEOUT_SECONDS=300
# Mesure capteur plus ancienne que ce délai (s) : considérée comme absente (0 = désactivé)
SENSOR_MAX_AGE_SECONDS=300

# --- Noms des sondes (identiques sur tous les écrans) --------------------------
# Automaticien (16/10/2026, corrigé) : PT01 / PT02 = liquide diélectrique (cuve, PT02 régulée),
# PT03 / PT04 = liquide de refroidissement (boucle du dry cooler). Aller / retour : à préciser.
# Nom complet / nom court.
PT01_LABEL=PT01 · liquide diélectrique
PT01_SHORT=PT01 · diélectrique
PT02_LABEL=PT02 · liquide diélectrique (régulé)
PT02_SHORT=PT02 · diélec. (régulé)
PT03_LABEL=PT03 · liquide de refroidissement
PT03_SHORT=PT03 · refroid.
PT04_LABEL=PT04 · liquide de refroidissement
PT04_SHORT=PT04 · refroid.

# --- Sens de circulation (côté chaud / froid de chaque circuit) ---------------
# DÉDUIT des mesures réelles (à confirmer avec l'automaticien) : PT02 (bain) > PT01 (sortie
# d'échangeur) et PT03 (vers le dry cooler) > PT04 (sortie du dry cooler). Sert au calcul
# d'efficacité de l'échangeur et, par défaut, de la puissance.
DIELECTRIC_HOT_COLUMN=pt02
DIELECTRIC_COLD_COLUMN=pt01
COOLANT_HOT_COLUMN=pt03
COOLANT_COLD_COLUMN=pt04

# --- Puissance thermique dissipée ESTIMÉE --------------------------------------
# P = débit HT01 × masse volumique × capacité thermique × (sonde chaude − sonde froide).
# Le cahier des charges place HT01 sur le circuit « bain d'huile » = DIÉLECTRIQUE : par défaut
# PT02 − PT01 et une huile diélectrique (≈ 850 kg/m³, 1900 J/kg/K). Si HT01 est en fait sur la
# boucle du dry cooler : THERMAL_POWER_HOT=pt03, THERMAL_POWER_COLD=pt04, 1040 et 3800 (eau
# glycolée). PT02 étant lue au degré près, la valeur instantanée est bruitée : lire une moyenne.
# THERMAL_POWER_CONFIRMED=true une fois fluide, débit et sondes confirmés.
THERMAL_FLUID_DENSITY_KG_M3=850
THERMAL_FLUID_HEAT_CAPACITY_J_KG_K=1900
THERMAL_POWER_HOT=pt02
THERMAL_POWER_COLD=pt01
THERMAL_POWER_CONFIRMED=false

# --- MQTT : publication des conditions et de la consigne pour l'automate ------
# Facultatif : sans broker joignable, tout fonctionne (collecte, alertes, interface),
# seule la publication vers l'automate est suspendue. Broker distant : activer TLS.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERT=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
# Interdit : la vérification TLS ne doit jamais être désactivée.
MQTT_TLS_INSECURE=false
MQTT_KEEPALIVE_SECONDS=60

# --- Base de données SQLite --------------------------------------------------
SQLITE_DB_PATH=voltaneum.db
RETENTION_DAYS=365
PREDICTIONS_RETENTION_DAYS=90
ALERTS_RETENTION_DAYS=365

# --- Collecte et boucle de contrôle ------------------------------------------
SNAPSHOT_INTERVAL_SECONDS=15
CONTROL_LOOP_INTERVAL_SECONDS=60
POINT_MAPPING_REFRESH_SECONDS=3600
# Écart max (s) entre deux mesures pour qu'elles appartiennent à un même segment continu
# (l'apprentissage ne relie jamais deux segments séparés par une coupure de collecte).
MAX_GAP_SECONDS=60

# --- Machine Learning ---------------------------------------------------------
MODEL_DIR=models

# Ré-entraînement automatique : chaque jour à RETRAIN_AT (heure locale, vide = désactivé).
# Il PROPOSE un modèle, ne l'installe jamais seul (validation : ./voltaneum model accept).
RETRAIN_AT=03:15
# Horizons essayés (secondes), du plus court au plus long : 10 min ... 24 h.
AUTO_RETRAIN_HORIZONS=600,900,1800,3600,7200,21600,43200,86400
# Retenu si l'erreur est au moins 20 % plus faible que la persistance ET sous 0,5 °C.
AUTO_RETRAIN_MIN_GAIN=0.2
AUTO_RETRAIN_MAX_RMSE_CELSIUS=0.5
# Données utilisées : les 90 derniers jours.
AUTO_RETRAIN_MAX_DAYS=90

# --- Régulation PID et sécurité process ---------------------------------------
TARGET_TEMP=35.0
CRITICAL_TEMP=55.0
# Seuil critique de PT01 (liquide diélectrique, cuve où baignent les équipements ; PT02 relève de
# CRITICAL_TEMP) : alerte CRITIQUE immédiate au-delà. À fixer avec l'exploitant.
DIELECTRIC_CRITICAL_TEMP=55.0
# Point de départ prudent, à régler sur site : Kp en % par °C d'écart, temps d'intégration
# Ti = Kp / Ki = 500 s, sans dérivée (bruit de mesure). Consigne INFORMATIVE.
PID_KP=10.0
PID_KI=0.02
PID_KD=0.0
# Âge max (s) du dernier message de la passerelle pour publier : au-delà, les mesures sont
# considérées périmées et RIEN n'est publié (l'automate reprend sa propre régulation).
# À augmenter seulement si la passerelle n'envoie ses valeurs que sur changement.
CONTROL_MAX_DATA_AGE_SECONDS=120
# Publie aussi la consigne PID en % (voltaneum/control/setpoint) : INFORMATIVE uniquement.
# Les conditions à suivre sont publiées sur voltaneum/control/cooling_conditions.
PUBLISH_PID_SETPOINT=true
# Les bandes de température extérieure (seuils de marche du ventilateur, centrés sur la cible
# décalée, fréquence minimale conseillée au ventilateur) et l'hystérésis se règlent dans config.py (OUTDOOR_BANDS, FAN_HYSTERESIS_CELSIUS) :
# valeurs INDICATIVES, à valider avec l'automaticien.

# --- Température extérieure : capteur physique indépendant -------------------
# "mqtt" (recommandé) : le capteur publie lui-même sur le broker MQTT.
# "http" : repli si le capteur ne peut exposer qu'une petite API HTTP.
# "none" : capteur pas encore installé (température prise sur l'API météo) — cas actuel.
OUTDOOR_SENSOR_MODE=none
OUTDOOR_SENSOR_MQTT_TOPIC=voltaneum/sensors/outdoor_temperature
OUTDOOR_SENSOR_HTTP_URL=
OUTDOOR_SENSOR_HTTP_TIMEOUT=5
# Mesure plus ancienne que ce délai (s) = considérée absente (capteur muet)
OUTDOOR_SENSOR_MAX_AGE_SECONDS=1800
# Sans valeur du capteur : température de l'API météo utilisée à la place
# (le capteur reste prioritaire ; la source est enregistrée en base)
OUTDOOR_WEATHER_FALLBACK_ENABLED=true
# Intervalle minimal entre deux appels à l'API météo (s) : l'API ne change qu'aux 15 min.
OUTDOOR_WEATHER_FALLBACK_REFRESH_SECONDS=600

# --- Vérification de cohérence capteur / météo -------------------------------
# Uniquement quand le capteur fournit une valeur ; un écart important et
# persistant déclenche une alerte de vérification.
OUTDOOR_CONSISTENCY_CHECK_INTERVAL_SECONDS=900
OUTDOOR_CONSISTENCY_MAX_GAP_CELSIUS=8.0
# Position du site (API météo : repli et comparaison)
VOLTANEUM_LAT=49.0364
VOLTANEUM_LON=2.0761

# --- Alertes : e-mail (SMTP) et règles ----------------------------------------
# Sans SMTP, les alertes restent journalisées et visibles dans l'interface (onglet Alertes).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_COOLDOWN_MINUTES=30
ALERT_CONFIRMATION_CYCLES=3
TELEMETRY_TIMEOUT_SECONDS=300
# Règle « pompe en marche sans débit » (valeurs indicatives, à valider) :
# fréquence (Hz) au-dessus de laquelle la pompe est « en marche », débit (m³/h) en dessous
# duquel il n'y a « pas de débit ».
PUMP_RUNNING_MIN_HZ=5.0
FLOW_MIN_M3H=0.5
# PT02 sans valeur alors que la passerelle émet : alerte après ce délai (s).
OIL_SENSOR_MISSING_ALERT_SECONDS=120
# PT02 strictement constante pendant ce délai (min) : valeur suspecte (0 = désactivé)...
SENSOR_FROZEN_ALERT_MINUTES=60
# ... seulement si PT01 (même circuit) a bougé d'au moins cet écart (°C) pendant ce temps :
# PT02 est lue au degré près, constante pendant des heures sur un procédé stable sans être en panne.
SENSOR_FROZEN_REFERENCE_SPAN_CELSIUS=1.0
# Règle « dérive d'efficacité » : formule non validée sur l'installation, désactivée par défaut.
EFFICIENCY_ALERT_ENABLED=false
EFFICIENCY_MIN_EXPECTED=0.0
EFFICIENCY_MAX_EXPECTED=1.0

# --- Protection automatique du stockage SQLite -------------------------------
# 1 099 511 627 776 octets = 1 Tio (valeur par défaut).
STORAGE_LIMIT_BYTES=1099511627776
# La limite effective ne dépasse jamais cette part du disque réel (taille base + espace libre).
STORAGE_DISK_MAX_SHARE=0.8
STORAGE_WARNING_RATIO=0.90
STORAGE_PURGE_TARGET_RATIO=0.75
STORAGE_GRACE_PERIOD_SECONDS=3600
STORAGE_CHECK_INTERVAL_SECONDS=300
STORAGE_PURGE_BATCH_SIZE=1000
STORAGE_BACKUP_DIR=backups
STORAGE_BACKUP_RETENTION_COUNT=7
# Une sauvegarde compressée n'est JAMAIS supprimée avant cet âge (jours) : données conservées
# au moins un an. Les STORAGE_BACKUP_RETENTION_COUNT plus récentes sont de plus toujours gardées.
STORAGE_BACKUP_MIN_AGE_DAYS=365
# Espace libre exigé sur le volume de sauvegarde, en multiple de la taille de la base.
STORAGE_BACKUP_FREE_SPACE_FACTOR=1.1
STORAGE_ALERT_COOLDOWN_MINUTES=60
# Sauvegarde quotidienne vérifiée de la base, les N plus récentes gardées (0 = désactivée).
STORAGE_DAILY_BACKUP_COUNT=7

# --- Interface web de supervision (lecture seule, dans le processus principal) -
DASHBOARD_ENABLED=true
# 127.0.0.1 : accessible seulement depuis la machine (tunnel SSH depuis un autre poste).
# 0.0.0.0 : accessible depuis le réseau, SANS authentification -> réseau de confiance uniquement.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Noms d'hôte acceptés en plus de localhost / adresses IP (séparés par des virgules).
DASHBOARD_ALLOWED_HOSTS=

# --- Journalisation ------------------------------------------------------------
LOG_LEVEL=INFO
