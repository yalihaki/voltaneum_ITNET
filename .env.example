# =============================================================================
# Voltaneum / ITNET — fichier d'exemple de configuration.
# Copier en ".env" et renseigner les valeurs réelles. Ne JAMAIS committer le
# ".env" lui-même (voir .gitignore) — ce fichier ne contient aucune valeur
# secrète, uniquement des exemples/valeurs par défaut sûres.
# =============================================================================

# --- Identifiants passerelle (OBLIGATOIRE, aucune valeur par défaut) --------
VOLTANEUM_USER=adlin
VOLTANEUM_PASSWORD=admin

# --- Réseau : automate / passerelle -----------------------------------------
GATEWAY_HOST=10.0.1.33
MANAGE_API_URL=http://10.0.1.33/ManageApi/Base.Auth.php
IOT_API_URL=http://10.0.1.33:8001/iot/query_all_points
WS_URL=ws://10.0.1.33:91
SENSOR_DRIVER_NODE=idospV1_1
# Flux muet au-delà de ce délai (s) : connexion rouverte (0 = désactivé)
WS_SILENCE_TIMEOUT_SECONDS=300

# --- MQTT (bus interne entre modules) ---------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=admin
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERT=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
# Interdit : la vérification TLS ne doit jamais être désactivée.
MQTT_TLS_INSECURE=false
MQTT_KEEPALIVE_SECONDS=60

# --- Base de données SQLite --------------------------------------------------
SQLITE_DB_PATH=voltaneum.db
RETENTION_DAYS=365
PREDICTIONS_RETENTION_DAYS=90
ALERTS_RETENTION_DAYS=365

# --- Collecte et boucle de contrôle ------------------------------------------
SNAPSHOT_INTERVAL_SECONDS=15
CONTROL_LOOP_INTERVAL_SECONDS=60
POINT_MAPPING_REFRESH_SECONDS=3600
# Durée max tolérée entre deux lectures pour qu'un segment soit "continu"
# (voir la leçon du 9 septembre 2026 dans CHANGELOG.md).
MAX_GAP_SECONDS=60

# --- Machine Learning ---------------------------------------------------------
MODEL_DIR=models

# --- Régulation PID et sécurité process ---------------------------------------
TARGET_TEMP=35.0
CRITICAL_TEMP=55.0
# Valeurs par défaut non calibrées sur le vrai système — à ajuster en Phase 3a
# une fois des données réelles disponibles (voir CAHIER_DES_CHARGES_FINAL.md).
PID_KP=5.0
PID_KI=0.1
PID_KD=1.0

# --- Température extérieure : capteur physique indépendant -------------------
# "mqtt" (recommandé) : le capteur publie lui-même sur le broker MQTT.
# "http" : repli si le capteur ne peut exposer qu'une petite API HTTP.
OUTDOOR_SENSOR_MODE=mqtt
OUTDOOR_SENSOR_MQTT_TOPIC=voltaneum/sensors/outdoor_temperature
OUTDOOR_SENSOR_HTTP_URL=
OUTDOOR_SENSOR_HTTP_TIMEOUT=5
# Mesure plus ancienne que ce délai (s) = considérée absente (capteur muet)
OUTDOOR_SENSOR_MAX_AGE_SECONDS=1800

# --- Vérification de cohérence capteur / météo (surveillance uniquement) -----
# La météo ne remplace JAMAIS le capteur ; un écart important et persistant
# déclenche seulement une alerte de vérification (voir CHANGELOG.md, point 10).
OUTDOOR_CONSISTENCY_CHECK_INTERVAL_SECONDS=900
OUTDOOR_CONSISTENCY_MAX_GAP_CELSIUS=8.0
# Position du site (API météo de COMPARAISON uniquement)
VOLTANEUM_LAT=48.8566
VOLTANEUM_LON=2.3522

# --- Notifications par email (SMTP) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_COOLDOWN_MINUTES=30
ALERT_CONFIRMATION_CYCLES=3
TELEMETRY_TIMEOUT_SECONDS=300
# Plage d'efficacité échangeur "attendue" — provisoire et large, à resserrer
# une fois des données réelles de fonctionnement normal collectées.
EFFICIENCY_MIN_EXPECTED=0.0
EFFICIENCY_MAX_EXPECTED=1.0

# --- Protection automatique du stockage SQLite -------------------------------
# 1 099 511 627 776 octets = 1 Tio (valeur par défaut).
STORAGE_LIMIT_BYTES=1099511627776
STORAGE_WARNING_RATIO=0.90
STORAGE_PURGE_TARGET_RATIO=0.75
STORAGE_GRACE_PERIOD_SECONDS=3600
STORAGE_CHECK_INTERVAL_SECONDS=300
STORAGE_PURGE_BATCH_SIZE=1000
STORAGE_BACKUP_DIR=backups
STORAGE_BACKUP_RETENTION_COUNT=7
STORAGE_ALERT_COOLDOWN_MINUTES=60

# --- Journalisation ------------------------------------------------------------
LOG_LEVEL=INFO
